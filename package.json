{
  "name": "virtualfab-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop.mjs",
  "scripts": {
    "start": "node server.mjs",
    "desktop": "electron .",
    "package:win": "electron-packager . VirtualFab --platform=win32 --arch=x64 --out=dist --asar --overwrite --ignore=artifacts --ignore=docs --ignore=tests --ignore=.git",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:desktop": "node tests/desktop.mjs",
    "test:desktop:packaged": "node tests/desktop.mjs --packaged",
    "validate:literature": "node benchmarks/run-literature.mjs",
    "validate:literature:strict": "node benchmarks/run-literature.mjs --strict",
    "test:literature:desktop": "node tests/literature-desktop.mjs",
    "check": "node --check desktop.mjs && node --check preload.cjs && node --check server.mjs && node --check src/app.js && node --check src/engine.js && node --check src/physics.js && node --check src/viewer.js"
  },
  "dependencies": {
    "split-grid": "1.0.11",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^44.4.5",
    "playwright": "^1.63.0"
  }
}
